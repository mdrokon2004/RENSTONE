# RENSTONE Environment Variables

# Public Supabase Configuration (Exposed to Vite client)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Public Store Contact Configuration Fallbacks (Configurable via Admin Dashboard)
VITE_STORE_NAME=RENSTONE
VITE_DEFAULT_WHATSAPP_NUMBER=8801700000000
VITE_DEFAULT_MESSENGER_URL=https://m.me/renstone.bd

# IMPORTANT SECURITY NOTE:
# Never put your Supabase 'service_role' secret key in this file or any file with VITE_ prefix.
# Service-role keys bypass all Row Level Security and must only be used in secure server environments.
